# Copy to .env and set private values locally. Never commit .env.
POSTGRES_DB=ai_phone
POSTGRES_USER=ai_phone
POSTGRES_PASSWORD=replace-with-a-random-local-password
# LAN address is discovered from private interfaces; no public listener.
# Configure models and API keys in Configuration > Agent after entering the app.
# Optional; leave empty for direct networking. Configure using ./ai-phone configure.
CONTAINER_HTTP_PROXY=
HOST_HTTP_PROXY=


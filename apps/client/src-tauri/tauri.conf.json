{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Phone",
  "version": "0.1.9",
  "identifier": "dev.aiphone.client",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        {
          "identifier": "local-connection",
          "windows": [
            "connection"
          ],
          "permissions": [
            "allow-current-server",
            "allow-connect-server",
            "allow-deployment-status",
            "allow-start-deployment",
            "allow-cancel-deployment",
            "allow-accept-deployment-license",
            "allow-fit-setup"
          ]
        },
        {
          "identifier": "local-workbench-updates",
          "local": false,
          "windows": ["workbench"],
          "remote": {
            "urls": [
              "http://127.0.0.1:17860/phone",
              "http://localhost:17860/phone",
              "http://[\\:\\:1]:17860/phone"
            ]
          },
          "permissions": [
            "allow-check-client-update",
            "allow-install-client-update"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/128x128.png"
    ],
    "copyright": "Copyright 2026 AI Phone contributors",
    "category": "Productivity",
    "shortDescription": "Your AI phone and computer",
    "resources": {
      "../../../LICENSE": "legal/LICENSE",
      "../../../NOTICE": "legal/NOTICE",
      "../../../PRIVACY.md": "legal/PRIVACY.md",
      "../../../DISCLAIMER.md": "legal/DISCLAIMER.md",
      "../../../THIRD_PARTY_NOTICES.md": "legal/THIRD_PARTY_NOTICES.md",
      "../../../docs/public/licenses/guest-apps/GPL-3.0.txt": "legal/GPL-3.0.txt",
      "../../../docs/public/native-client-licenses.txt": "legal/native-client-licenses.txt",
      "gen/host/source.payload": "host/source.payload"
    },
    "macOS": {
      "minimumSystemVersion": "14.4"
    }
  }
}
